{
  "name": "poe2-tools",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Set of tools for the Path of Exile 2 video game",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest --coverage",
    "lint": "biome ci",
    "fix": "biome check --write",
    "prepare": "husky",
    "ts:check": "tsc",
    "verify": "npx tsc && biome ci && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Adult-In-The-Room/poe2-tools.git"
  },
  "keywords": [
    "React",
    "Path of Exile 2",
    "Video Games"
  ],
  "author": "Raymond Cox",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/The-Adult-In-The-Room/poe2-tools/issues"
  },
  "homepage": "https://github.com/The-Adult-In-The-Room/poe2-tools#readme",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.9",
    "@tanstack/react-router": "^1.170.24",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.41",
    "@tanstack/router-plugin": "^1.168.27",
    "nitro": "npm:nitro-nightly@^3.0.1-20260731-205209-52abde8a",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/router-cli": "^1.167.25",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched"
  }
}
