{
  "name": "poe2-tools",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Set of tools for the Path of Exile 2 video game",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest --coverage",
    "test:ci": "vitest run",
    "test:e2e:smoke": "npm run build && playwright test --project=smoke",
    "test:e2e:acceptance": "npm run build && USE_MOCK_POE_NINJA=true playwright test --project=acceptance",
    "test:e2e:acceptance:gui": "npm run build && USE_MOCK_POE_NINJA=true playwright test --project=acceptance --ui",
    "lint": "biome ci",
    "fix": "biome check --write",
    "prepare": "simple-git-hooks",
    "ts:check": "tsc",
    "verify": "tsc && biome ci && npm run test:ci"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Adult-In-The-Room/poe2-tools.git"
  },
  "keywords": [
    "React",
    "Path of Exile 2",
    "Video Games",
    "ARPG"
  ],
  "author": "Raymond Cox",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/The-Adult-In-The-Room/poe2-tools/issues"
  },
  "homepage": "https://github.com/The-Adult-In-The-Room/poe2-tools#readme",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.10",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.50",
    "@tanstack/router-plugin": "^1.168.27",
    "nitro": "npm:nitro-nightly@latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.63.0",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/router-cli": "^1.167.34",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "happy-dom": "^20.14.0",
    "lint-staged": "^17.5.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true
  }
}
